# Contact form — Web3Forms public access key
# https://web3forms.com — free tier, key is safe to expose client-side.
# When unset, ContactForm logs submissions to the browser console (dev mode).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Site URL (used for absolute canonical + OG image URLs)
NEXT_PUBLIC_SITE_URL=https://yasir.dev

# Chat provider (Milestone D+): leave unset for local deterministic mode.
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
